# Puerto del servidor
PORT=4000

# development | production | test
APP_ENV=development

# Orígenes CORS permitidos (separados por coma)
CORS_ORIGINS=http://localhost:5173

# PostgreSQL (fallback local — solo se usa si NO hay DATABASE_URL de Neon)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=pluxee

# --- Neon (base de datos compartida en la nube) ---
# La app detecta automáticamente ../.env.local de la raíz (lo escribe
# `neon env pull` / `neon deploy`), así que NO hace falta copiar nada aquí.
# Estas variables solo sirven para forzar otra conexión desde este archivo
# (tienen prioridad sobre .env.local). DATABASE_URL = app (pooled),
# DATABASE_URL_UNPOOLED = migraciones de Alembic (conexión directa):
# DATABASE_URL=postgresql+psycopg://usuario:clave@host-pooler/neondb?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql+psycopg://usuario:clave@host/neondb?sslmode=require
# Para volver a la Postgres local: borra ../.env.local o define aquí DATABASE_URL.
