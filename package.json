{
  "name": "pluxee-employee-benefits",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "dev:api": "cd backend && .venv\\Scripts\\python -m app.server",
    "build": "npm run build --prefix frontend",
    "lint": "npm run lint --prefix frontend",
    "start:api": "cd backend && .venv\\Scripts\\python -m app.server",
    "seed": "cd backend && .venv\\Scripts\\python scripts\\seed.py",
    "seed:test": "cd backend && .venv\\Scripts\\python -m dotenv -f .env.test run .venv\\Scripts\\python scripts\\seed.py --reset",
    "test:api": "cd backend && .venv\\Scripts\\python -m pytest"
  }
}
